# =========================================================================
# CONFIGURACIÓN DEL ENTORNO DE PRODUCCIÓN/DESARROLLO - BACKEND (PHP)
# =========================================================================
# 
# ADVERTENCIA DE SEGURIDAD CRÍTICA:
# Este archivo contiene credenciales altamente confidenciales del servidor de
# correo SMTP. NUNCA debe subirse al repositorio de control de versiones (Git)
# ni exponerse de ninguna manera en la carpeta pública o frontend.
#
# En producción (Vercel), estas variables se configuran en el panel web
# del proyecto Vercel -> Settings -> Environment Variables.
# =========================================================================

# Dirección de correo electrónico destinataria que recibirá todos los mensajes del formulario
MAIL_TO=davila.va.23@gmail.com

# Nombre del remitente que aparecerá en el asunto del correo recibido
MAIL_FROM_NAME="Portfolio de Estiven"

# Servidor del Host de salida SMTP (ej: smtp.gmail.com para Google Gmail)
MAIL_SMTP_HOST=smtp.gmail.com

# Puerto SMTP para la salida de correos (ej: 587 para TLS/STARTTLS, o 465 para SSL)
MAIL_SMTP_PORT=587

# Protocolo de seguridad para cifrar la conexión SMTP (tls o ssl)
MAIL_SMTP_SECURE=tls

# Nombre de usuario de la cuenta SMTP (usualmente tu dirección de correo electrónico completa)
MAIL_SMTP_USER=tu_correo@gmail.com

# Contraseña de aplicación única generada para SMTP (App Password en Gmail)
# NUNCA compartas ni comprometas esta clave secreta.
MAIL_SMTP_PASS=tu_contraseña_de_aplicación
