# =========================================================================
# CONFIGURACIÓN DEL ENTORNO DE DESARROLLO - FRONTEND (Vite / Vue)
# =========================================================================
# 
# NOTA IMPORTANTE DE SEGURIDAD:
# Este archivo contiene variables que se inyectan en el navegador del cliente
# durante la compilación (build time). Solo deben definirse aquí configuraciones
# públicas o URLs de APIs. NUNCA coloques contraseñas o claves privadas aquí.
# 
# Las variables del frontend en Vite DEBEN comenzar obligatoriamente con el
# prefijo 'VITE_' para que sean accesibles a través de 'import.meta.env'.
# =========================================================================

# URL del endpoint de la API PHP que procesa el formulario de contacto.
# En desarrollo local apunta a tu servidor local de Apache/XAMPP.
VITE_API_URL=http://localhost/portfolio/api/contact.php
